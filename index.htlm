          <circle cx="50" cy="50" r="40" fill="none" stroke="rgba(201,162,39,0.08)" stroke-width="18"/>
          <!-- Propriétaire: 85% = 213.6 de 251.2 -->
          <circle cx="50" cy="50" r="40" fill="none" stroke="#C9A227" stroke-width="18"
            stroke-dasharray="213.6 37.6" stroke-dashoffset="62.8" opacity="0.85"/>
